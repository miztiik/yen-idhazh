{
  "description": "Bounded offline protocol cases using the existing recorded transport, not live-source availability claims.",
  "cases": [
    {"name": "forbidden", "url": "https://news.example/forbidden", "responses": [{"status": 403, "body": ""}], "expected": {"http_status": 403, "fetch_failure": "http", "error_code": null}},
    {"name": "rate-limited", "url": "https://news.example/rate-limited", "responses": [{"status": 429, "body": ""}], "expected": {"http_status": 429, "fetch_failure": "http", "error_code": null}},
    {"name": "dns", "url": "https://unresolved.example/article", "responses": [{"error": "ENOTFOUND"}], "expected": {"http_status": null, "fetch_failure": "dns", "error_code": "ENOTFOUND"}},
    {"name": "tls", "url": "https://news.example/tls", "responses": [{"error": "CERT_HAS_EXPIRED"}], "expected": {"http_status": null, "fetch_failure": "network", "error_code": "CERT_HAS_EXPIRED"}},
    {"name": "timeout", "url": "https://news.example/deadline", "responses": [{"error": "ETIMEDOUT"}], "expected": {"http_status": null, "fetch_failure": "timeout", "error_code": "ETIMEDOUT"}},
    {"name": "empty-extraction", "url": "https://news.example/empty-body", "responses": [{"status": 200, "body": ""}], "expected": {"http_status": 200, "fetch_failure": null, "error_code": null}}
  ]
}
