{
  "name": "yen-idhazh-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && node scripts/build-frame-css.mjs && node scripts/build-worker-switch.mjs && node scripts/copy-visuals.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
