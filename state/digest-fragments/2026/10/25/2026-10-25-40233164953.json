    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "unsupported_number","carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-t4127592n37bgfng","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:51:39Z","rank_score": 1.197195,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "euronews","source_kind": "reporting","source_name": "Euronews","source_url": "https://euronews.com/2026/10/25/vucic-concedes-defeat-in-pivotal-serbian-elections-says-student-movement-has-won","summary": "Aleksandar Vu\u010di\u0107, leader of the Serbian Progressive Party and former president, conceded that the Student List won Serbia's parliamentary election. Framed as a referendum on his decade-plus dominance, he said preliminary results give the movement 135 to 140 seats\u2014enough for a majority\u2014and around 2.2 million votes (52%), versus roughly 1.72 million (32.3%) for his party. He called it a new political era; coverage notes the story is developing.","time_source": "feed","title": "Serbian President Concedes Student List Victory in Parliamentary Election","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
