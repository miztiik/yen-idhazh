    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["anthropic"],"events": ["regulation"],"introduced_by_run": 1,"item_id": "ai-eja2kadsb3xmrejb","lenses": [],"on_front_page": false,"published_at": "2026-10-25T18:25:59Z","rank_score": 1.643894,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "guardian-ai","source_kind": "reporting","source_name": "The Guardian - AI","source_url": "https://theguardian.com/us-news/2026/oct/25/elvis-presley-anthropic-lawsuit-ai-models-music","summary": "The owners of Elvis Presley\u2019s music catalogue, Authentic Brands Group, are suing the AI company Anthropic for allegedly using 274 of Presley\u2019s songs to train its models without permission. The lawsuit was filed on Friday and reportedly first covered by Billboard. It claims Anthropic infringed rights across virtually every song available online and seeks $150,000 per track, or about $41m (about \u00a331m). Lead attorney Richard Busch argued the case could set a broad precedent for how AI firms use existing music catalogues.","time_source": "feed","title": "Elvis Catalogue Owners Sue Anthropic Over AI Training","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["nvidia","tesla"],"events": ["capex","deal","funding","release"],"introduced_by_run": 1,"item_id": "business-economy-02b9v72c36rcprrs","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-25T20:05:24Z","rank_score": 1.479729,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/musk-says-spacex-raised-40-billion-in-debt-gpus-6491471","summary": "Elon Musk said SpaceX had closed $40 billion in debt financing for graphics processing units, noting the company's investment-grade status and revenue from Starlink and its launch business helped preserve credit access. The callable debt will arrive in Q1 and Q2. This follows Reuters reporting that SpaceX is in talks to raise the same amount for Nvidia AI chips, underscoring the enormous capital demands of the AI boom as companies race to secure advanced processors.","time_source": "feed","title": "SpaceX Secures $40 Billion Debt Financing for GPU Purchases","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "business-economy-49xbaf1pth0pqqvx","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:00:05Z","rank_score": 1.177754,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "business-today-in","source_kind": "reporting","source_name": "Business Today","source_url": "https://businesstoday.in/personal-finance/story/sudden-rains-flooded-roads-which-motor-insurance-add-ons-can-protect-your-car-from-expensive-repairs-563513-2026-10-26","summary": "Sudden downpours and localised flooding can leave motorists facing unexpected repair bills even outside the traditional monsoon season. As weather patterns become increasingly unpredictable, car owners need to understand what their motor insurance covers and whether additional protection is necessary. For a 34-year-old software engineer commuting through Bengaluru, heavy rain can turn familiar roads into waterlogged stretches. If the car stalls in floodwater and requires towing and repairs, costs could depend significantly on the policy and add-ons purchased.","time_source": "feed","title": "Motor Insurance Add-Ons for Flood and Sudden Rain Damage","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": false},
