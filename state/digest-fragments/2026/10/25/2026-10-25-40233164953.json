    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["funding"],"introduced_by_run": 1,"item_id": "india-k6pe1d955gwys11p","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:25:00Z","rank_score": 1.187068,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "toi-top","source_kind": "reporting","source_name": "Times of India","source_url": "https://timesofindia.indiatimes.com/world/us/pink-headlined-a-san-diego-concert-that-raised-8-25-million-for-cancer-research-the-benefit-series-has-now-generated-more-than-28-million-across-four-star-powered-events/articleshow/135188558.cms","summary": "A May 15 concert in San Diego featuring singer Pink raised $8.25 million for cancer research through Curebound, a San Diego-based organisation supporting cancer research. The event drew around 25,000 attendees at Petco Park and marked the latest contribution to the Concert for Cures series, which has collected more than $28 million across four concerts since 2022. Pink spoke about gratitude toward those involved in the cause.","time_source": "feed","title": "Pink's San Diego cancer benefit raises $8.25m, taking series past $28m","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "india-psxcv56zany76fb3","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:20:00Z","rank_score": 1.185187,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "free-press-journal","source_kind": "reporting","source_name": "Free Press Journal","source_url": "https://freepressjournal.in/spirituality/guiding-light-art-of-effective-communication","summary": "This piece argues that strong communication skills and a calm, collected mind are essential for handling any situation well. It explains that steering conversation is a balancing act: one must listen while also sharing views skillfully, since neither pure listening nor talking without giving others a chance makes communication effective. A Vedic couplet advises to speak the truth pleasantly but not an unpleasant truth or pleasant lie, and regular meditation helps find the right way to express oneself.","time_source": "feed","title": "Guiding Light: Art Of Effective Communication","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["deal","regulation"],"introduced_by_run": 1,"item_id": "india-vhhckt07pk5zjwkx","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:20:00Z","rank_score": 1.185187,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "toi-top","source_kind": "reporting","source_name": "Times of India","source_url": "https://timesofindia.indiatimes.com/world/us/a-new-york-homeowner-signed-a-mortgage-in-2005-and-later-faced-foreclosure-after-a-bank-won-a-ruling-an-appeals-court-reversed-it-because-the-lender-had-not-proved-it-could-enforce-the-note/articleshow/135189067.cms","summary": "A New York appeals court reversed a lower-court foreclosure ruling after US Bank National Association failed to prove its right to enforce the loan. Moses Sukljian, who signed a 2005 mortgage in Albany County, argued the bank could not establish standing because key documents were undated and absent from the original complaint. The two allonges it later produced lacked dates and prior inclusion, so judgment for the bank was vacated without a trial.","time_source": "feed","title": "Appeals Court Reverses Foreclosure Ruling Over Missing Loan Documents","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": false}
