    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-amhvtsyd67r171sf","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:31:30Z","rank_score": 1.189522,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "abc-au-world","source_kind": "reporting","source_name": "ABC News Australia","source_url": "https://abc.net.au/news/2026-10-26/bournda-bird-olympics-2026-merimbula/107298364","summary": "Forty students competed in the ninth edition of the 2026 Bournda Bird Olympics, held in Merimbula on the NSW far south coast. Competitors mimicked native Australian birds over an hour while judges considered accuracy and creativity. Tathra Public School won; judge Bob Harris said it fosters interest in nature.","time_source": "feed","title": "Forty students revive bird calling at Bournda Bird Olympics","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-xamhm0pmnxzqzsf0","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:29:25Z","rank_score": 1.188734,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "guardian-world","source_kind": "reporting","source_name": "The Guardian - World","source_url": "https://theguardian.com/environment/2026/oct/25/cabinet-split-emerges-over-controversial-rosebank-oilfield-decision","summary": "A cabinet split has emerged over whether to approve drilling at the controversial North Sea Rosebank oilfield, with chancellor John Healey in favour and energy secretary Miatta Fahnbulleh leaning toward rejection. A final decision is expected before year end; if rejected, it would be a blow for the industry but a victory for climate campaigners.","time_source": "feed","title": "Cabinet split over Rosebank oilfield drilling approval","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["deal","regulation"],"introduced_by_run": 1,"item_id": "world-78adw2ketbsam4n2","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:28:46Z","rank_score": 1.188489,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-world","source_kind": "reporting","source_name": "CNA","source_url": "https://channelnewsasia.com/world/billionaire-trump-backer-says-ben-gvir-smotrich-should-not-serve-in-next-israeli-government-6490701","summary": "Bill Ackman, founder of Pershing Square Capital Management, said on Sunday that Itamar Ben-Gvir and Bezalel Smotrich should not serve in Israel's next government. He argued their exclusion would signal Israel was 'turning a new page' after they caused what he called enormous reputational damage. The statement came two days before the election, which polls show is tight between Netanyahu's coalition and opposition parties.","time_source": "feed","title": "Ackman Opposes Ben-Gvir and Smotrich in Next Israeli Cabinet","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 2,"desk": null,"entities": [],"events": ["regulation","research"],"introduced_by_run": 1,"item_id": "india-jtp64dfd4k5ny1fa","lenses": [],"on_front_page": false,"published_at": "2026-10-25T20:48:10Z","rank_score": 1.445862,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "toi-india","source_kind": "reporting","source_name": "Times of India - India","source_url": "https://timesofindia.indiatimes.com/india/epfo-considers-rs-25000cr-war-chest-to-stabilise-interest-payouts/articleshow/135197531.cms","summary": "The Employees\u2019 Provident Fund Organisation is discussing a dedicated Rs 25,000-crore Interest Stabilisation Reserve (ISR) to protect the annual interest payouts of its nearly 30 crore members from corporate bond defaults and forced-exit losses. A report by IIM Kozhikode recommended building it progressively via surplus ETF gains and investing only in liquid government securities; EPFO\u2019s investment committee reviewed it Thursday, and the proposal has been sent to a high-powered panel studying the agency\u2019s investment framework.","time_source": "feed","title": "EPFO Weighs Rs 25,000-crore Reserve to Shield Member Interest Payouts","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": false},
