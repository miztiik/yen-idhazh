    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["google"],"events": ["regulation"],"introduced_by_run": 1,"item_id": "ai-vm5ygzxta3vhqaed","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:00:00Z","rank_score": 2.029078,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "google-cloud-ai","source_kind": "announcement","source_name": "Google Cloud AI Blog","source_url": "https://cloud.google.com/blog/topics/financial-services/easy-to-integrate-compliant-by-design-bringing-the-swiss-franc-to-google-cloud-universal-ledger","summary": "Switzerland's Crypto Finance Group launched a pilot of the Google Cloud Universal Ledger (GCUL) to demonstrate instant, account-to-account transfers between customers of two Swiss banks. The test ran within weeks and operated under deferred settlement for capital efficiency while offering clients real-time payments. GCUL provides secure-by-design infrastructure on Google Cloud with encryption and access controls that address regulatory concerns about public stablecoins like Tether and USDC. Crypto Finance acted as the currency operator, establishing rules for interbank settlement and compliance protocols. The pilot showed blockchain-based payment rails can support commercial bank money without compromising strict regulation or core banking stability.","time_source": "feed","title": "Crypto Finance Group Deploys Swiss Franc on Google Cloud Universal Ledger Pilot","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","amd","anthropic","google","nvidia"],"events": ["capex","release"],"introduced_by_run": 1,"item_id": "ai-t0b6pe8xhdmd0qyh","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-26T21:27:15Z","rank_score": 1.670453,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "wired-ai","source_kind": "reporting","source_name": "WIRED - AI","source_url": "https://wired.com/story/anthropic-prospectus-leaves-out-some-numbers","summary": "Anthropic filed its S-1 prospectus on Monday, detailing parts of its business but omitting certain financial figures. The filing cites revenue growing from $0 at commercial launch in the first quarter of 2023 to an undisclosed amount for three months ended September 30, 2026. Redactions largely concern recent-quarter financials and compute-related lease agreements. Michael Dambra attributes this partly to timing and liability concerns; Erica Neuman notes redacting confidential contract details is common but may hinder investor analysis of cash flow. Patrick Moorhead argues investors deserve more granular detail on risks, while Ben Bajarin expects gaps filled in an updated draft.","time_source": "feed","title": "Anthropic's IPO Prospectus Redacts Key Financial Figures, Experts Say","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["apple"],"events": ["incident","release"],"introduced_by_run": 1,"item_id": "ai-3zckxtk25sbe9cnq","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:52:35Z","rank_score": 1.657901,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "zdnet-ai","source_kind": "reporting","source_name": "ZDNET - AI","source_url": "https://zdnet.com/tech/apple-ios-27-2-update-siri-ai-facetime-dual-cameras","summary": "ZDNET reports that Apple released iOS 27. 2, its first major update for the current operating system, on Monday in 2026. The version emphasizes improvements to Siri AI, which can now recall past conversations and tap into voicemails, reading lists, Safari history, photos from messages, and calendar guests. It also adds dual camera support for FaceTime calls, letting users stream themselves via the front camera while others appear through the rear one; recipients must update their devices too. Other changes include a third-party sign language interpreter or live captioner option, Multiview Expansion for watching up to four sporting events at once with an Apple TV subscription, and updates across Podcasts and Shared Albums. The release follows minor version 27. 0. 1 in late September and precedes the iPhone Duo\u2019s dedicated iOS 27. 1 update. ZDNET notes that a Health app overhaul still appears later this year, likely with iOS 27. 3 in December.","time_source": "feed","title": "Apple Rolls Out iOS 27.2 With Siri AI and FaceTime Camera Upgrades","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["openai"],"events": ["release"],"introduced_by_run": 1,"item_id": "ai-bw2xz16wrrxggc1f","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:46:49Z","rank_score": 1.65584,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "bleepingcomputer","source_kind": "reporting","source_name": "BleepingComputer","source_url": "https://bleepingcomputer.com/news/artificial-intelligence/openai-launches-gpt-61-terra-with-3x-faster-ai-agents-50-percent-lower-pricing","summary": "OpenAI launched GPT-6.1 Terra, a model focused on computer use, visual reasoning, coding, and everyday work, priced significantly below its larger models. In an OpenAI blog post it described the release as combining detailed visual reasoning with precise computer use and clearer writing. API pricing is 50% lower than GPT-5.6 Terra and GPT-6.1 Sol at $1 per million input tokens and $5 per million output tokens.","time_source": "feed","title": "OpenAI launches GPT-6.1 Terra with faster agents and lower pricing","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["tesla"],"events": ["funding"],"introduced_by_run": 1,"item_id": "energy-bhs5dyyppa2w500k","lenses": ["china","trade"],"on_front_page": false,"published_at": "2026-10-26T21:18:39Z","rank_score": 1.667313,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "electrek","source_kind": "reporting","source_name": "Electrek","source_url": "https://electrek.co/2026/10/26/tesla-us-built-model-3-canada-return-584-km","summary": "A Canadian owner spotted Tesla Canada updating its website with a Model 3 Premium RWD rated at 584 km of range and a 0-100 km/h time of 5.2 seconds, matching the Fremont-built car sold there two years ago rather than the Shanghai-built version currently paused by import quotas. The configurator has not changed; Tesla still lists the $39,490 Premium RWD as unavailable until more government quota arrives, expected March 2027. Electrek says Tesla usually rewrites specs only for cars it plans to sell and sees this as a possible stopgap offer before the Performance-only lineup continues into spring.","time_source": "feed","title": "Tesla Canada spec update hints at returning US-built Model 3","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "energy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["anthropic"],"events": ["acquisition","deal"],"introduced_by_run": 1,"item_id": "business-economy-wx2j6qsqq3a1e6d3","lenses": ["chips"],"on_front_page": false,"published_at": "2026-10-26T20:31:59Z","rank_score": 1.950573,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/wall-st-banks-blackstone-line-up-63-billion-finance-broadcom-ai-chips-anthropic-6494381","summary": "On October 26, Bank of America, Citi, Morgan Stanley and Blackstone agreed to provide $63 billion in financing to buy Broadcom's AI chips and networking gear for Anthropic. The deal runs through a new special purpose vehicle that will lease the equipment until deliveries begin in 2027.","time_source": "feed","title": "Banks and Blackstone Finance Broadcom Chips for Anthropic","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","anthropic","google"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-7sczppj2n602srqk","lenses": ["markets"],"on_front_page": false,"published_at": "2026-10-26T22:22:15Z","rank_score": 1.690949,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "semafor","source_kind": "reporting","source_name": "Semafor","source_url": "https://semafor.com/article/10/26/2026/anthropic-ipo-filing-discloses-first-of-its-kind-governance-structure","summary": "Anthropic\u2019s seven co-founders will control the company through one golden share of supervoting stock, giving the first-of-its-kind listing a new governance structure. Early investors Amazon and Google hold only nonvoting stock, while a council of \u201cfinancially disinterested trustees with expertise in AI safety\u201d selects most of its board. The 318-page filing devoted 94 pages to AI risk, warning that one catastrophic incident may exceed the insurance industry\u2019s capacity to underwrite it.","time_source": "feed","title": "Anthropic\u2019s IPO filing unveils novel supervoting governance and candid AI-risk warning","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["apple","samsung"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-svnktxzedqw2f90f","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:43:01Z","rank_score": 1.654486,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/apple-says-it-will-replace-iphone-duo-units-showing-screen-problems-6494391","summary": "Days after launching its first folding phone, Apple acknowledged that some iPhone Duo units show display problems and said it will replace them. The issues appeared along the central hinge on social media over the weekend. In a statement, Apple noted affected devices tend to fail quickly and directed users to contact AppleCare for replacements. It did not comment on causes.","time_source": "feed","title": "Apple Offers Replacements for iPhone Duo Display Faults","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "unsupported_number","carried_by": 1,"desk": null,"entities": ["amazon","anthropic","ecb","federal-reserve","google","microsoft"],"events": ["capex","deal","earnings"],"introduced_by_run": 1,"item_id": "world-vss1gnv1wy0mb138","lenses": ["china","chips","markets"],"on_front_page": false,"published_at": "2026-10-26T21:29:59Z","rank_score": 1.671454,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "abc-au-world","source_kind": "reporting","source_name": "ABC News Australia","source_url": "https://abc.net.au/news/2026-10-27/asx-markets-business-live-news-anthropic/107312526","summary": "Anthropic filed to list on the Nasdaq under ticker ANT, disclosing steep losses alongside strong revenue growth. Analyst Dan Ives called the numbers 'eye-popping,' citing broad customer expansion from 950 in September 2025 to nearly 12,000 a year later and consumption-based revenue of $13.1 billion for the first half of 2026.","time_source": "feed","title": "Anthropic Files for Nasdaq IPO Amid Revenue Growth and Widening Losses","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon"],"events": ["regulation","research"],"introduced_by_run": 1,"item_id": "world-pfhmgkykydqpqjbq","lenses": [],"on_front_page": false,"published_at": "2026-10-26T21:26:42Z","rank_score": 1.670251,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "mongabay","source_kind": "reporting","source_name": "Mongabay","source_url": "https://news.mongabay.com/short-article/2026/10/organized-crime-is-growing-along-highway-in-a-pristine-section-of-the-amazon-study","summary": "A new study finds criminal organizations tied to illegal logging, gold mining, land grabbing and cattle ranching now dominate large areas around the BR-319 highway in a major stretch of Brazilian Amazon forest. The research measured deforestation rising after 2015, when maintenance work resumed following years of disrepair. Lead author Lucas Ferrante said weak surveillance enabled crime, while conservationists warn paving could trigger more destruction.","time_source": "feed","title": "Study Links Organized Crime to Amazon Highway Deforestation","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","meta"],"events": ["funding","regulation"],"introduced_by_run": 1,"item_id": "world-ye4p9yqdj1aakss2","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:28:16Z","rank_score": 1.649262,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "mongabay","source_kind": "reporting","source_name": "Mongabay","source_url": "https://news.mongabay.com/2026/10/canadian-backed-potash-mine-in-brazil-has-dried-up-sacred-amazon-springs-say-residents","summary": "Residents of Brazil's Amazonas state say an access road for the controversial Pot\u00e1ssio Autazes potash project has dried up at least two sacred springs used by the Mura Indigenous people, threatening a fish spawning ground and food supply. The company, Pot\u00e1ssio do Brasil, says it inspected the site on Oct. 8, 2026, and found no signs of drying or altered water flow. Federal prosecutors say expert assessments call the project's environmental studies incomplete and flawed, while lawsuits challenging its licenses remain pending. Mongabay reports the dispute spans a decade.","time_source": "feed","title": "Mura Residents Say Potash Road Dried Up Sacred Amazon Springs","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
