    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["google"],"events": ["regulation"],"introduced_by_run": 1,"item_id": "ai-vm5ygzxta3vhqaed","lenses": [],"on_front_page": false,"published_at": "2026-10-26T20:00:00Z","rank_score": 2.004921,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "google-cloud-ai","source_kind": "announcement","source_name": "Google Cloud AI Blog","source_url": "https://cloud.google.com/blog/topics/financial-services/easy-to-integrate-compliant-by-design-bringing-the-swiss-franc-to-google-cloud-universal-ledger","summary": "Switzerland's Crypto Finance Group launched a pilot of the Google Cloud Universal Ledger (GCUL) to demonstrate instant, account-to-account transfers between customers of two Swiss banks. The test ran within weeks and operated under deferred settlement for capital efficiency while offering clients real-time payments. GCUL provides secure-by-design infrastructure on Google Cloud with encryption and access controls that address regulatory concerns about public stablecoins like Tether and USDC. Crypto Finance acted as the currency operator, establishing rules for interbank settlement and compliance protocols. The pilot showed blockchain-based payment rails can support commercial bank money without compromising strict regulation or core banking stability.","time_source": "feed","title": "Crypto Finance Group Deploys Swiss Franc on Google Cloud Universal Ledger Pilot","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
