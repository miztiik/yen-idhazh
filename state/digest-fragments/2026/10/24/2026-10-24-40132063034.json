    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-4zzeqghr7bmab1n0","lenses": [],"on_front_page": false,"published_at": "2026-10-24T20:28:58Z","rank_score": 1.188495,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-world","source_kind": "reporting","source_name": "CNA","source_url": "https://channelnewsasia.com/world/uk-police-say-claims-over-meghan-markles-dad-not-sent-other-law-enforcement-6489761","summary": "The Metropolitan Police confirmed it received a letter in January 2019 containing claims about alleged offending outside the United Kingdom relating to Thomas Markle, father of Prince Harry's wife. It passed the information to Harry and Meghan but did not share details with other law enforcement agencies. Meghan said she was deeply distressed by accusations that her father possessed child abuse images. A source close to the matter disputed police assurances that allegations were being investigated.","time_source": "feed","title": "Metropolitan Police Say Claims About Meghan Markle's Father Were Not Shared With Other Agencies","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
