    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["rbi"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-d7gq009mc0ked5t5","lenses": [],"on_front_page": false,"published_at": "2026-10-24T12:48:39Z","rank_score": 1.537964,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "business-today-in","source_kind": "reporting","source_name": "Business Today","source_url": "https://businesstoday.in/personal-finance/story/rbi-forex-reporting-rules-freelancers-service-exporters-face-confusion-over-edf-filings-563459-2026-10-24","summary": "Indian service exporters, freelancers and technology startups are raising concerns about the Reserve Bank of India's new foreign exchange reporting framework that took effect on October 1, 2026. The dispute centers on Export Declaration Form requirements, with some banks asking individuals earning from overseas services to file despite RBI Governor Sanjay Malhotra assuring they would not be required to report. The absence of formal clarification has left banks interpreting rules differently.","time_source": "feed","title": "Freelancers and service exporters face confusion over RBI EDF filings","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-7mpxfw3berp10rhf","lenses": ["china"],"on_front_page": false,"published_at": "2026-10-24T09:48:37Z","rank_score": 1.390173,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cgtn-opnion","source_kind": "reporting","source_name": "China Global Television Network","source_url": "https://news.cgtn.com/news/2026-10-24/What-traditional-Chinese-wisdom-reveals-about-Party-governance-1Rt9URlbZio/p.html","summary": "A CGTN opinion column titled 'What traditional Chinese wisdom reveals about Party governance' draws on the ancient principle of Shen Du, described as remaining true to oneself and exercising self-restraint even when alone. The author notes that these ideals are gaining relevance among a new generation and links them to personal integrity and the CPC's commitment to full and rigorous self-governance.","time_source": "feed","title": "CGTN Column Links Chinese Wisdom to Party Self-Governance","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-9n1xsqeehj0rv5pp","lenses": ["china"],"on_front_page": false,"published_at": "2026-10-24T09:46:17Z","rank_score": 1.389589,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cgtn-opnion","source_kind": "reporting","source_name": "China Global Television Network","source_url": "https://news.cgtn.com/news/2026-10-24/The-Long-March-at-90-What-a-great-feat-teaches-a-new-generation-1RvbWlXubfi/p.html","summary": "A CGTN commentary by Wang Yan, an associate research fellow at Beijing Foreign Studies University, argues that 90 years after its end, the Long March is remembered chiefly for conviction rather than hardship. Writing that what carried an army across 12,500 kilometers was sheer conviction, she notes Xi Jinping called the triumph 'inevitable' and attributed it to CPC leadership, unshakable conviction, an independent course and popular support. The piece outlines three lessons\u2014conviction as direction, strategic composure blending resolve with flexibility, and endurance reframed for a generation facing competition rather than battle\u2014and urges young people to rediscover the spirit through study, virtual reality and film. It quotes Xi saying 'Only by remembering history can we open up the future.' Views are the author's own.","time_source": "feed","title": "Commentary frames the Long March's spirit as a guide for young China","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["deal"],"introduced_by_run": 1,"item_id": "world-45rrmjak24szn3ag","lenses": ["war"],"on_front_page": false,"published_at": "2026-10-24T20:52:07Z","rank_score": 1.197304,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "anadolu-world","source_kind": "reporting","source_name": "Anadolu Agency","source_url": "https://aa.com.tr/en/world/trump-says-us-could-strike-iran-tomorrow-or-reach-big-beautiful-deal/4099883","summary": "US President Donald Trump said on Saturday, October 24, 2026, that Washington could attack Iran as soon as tomorrow or reach a big, beautiful agreement. Asked how far along he was in considering an attack, Trump told reporters they were thinking about it and maybe doing it the next day. He framed his goal as making any outcome permanent to prevent Iran from developing nuclear weapons, while offering no firm decision on what comes next.","time_source": "feed","title": "Trump warns of imminent strike or deal with Iran","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-5wmjhhnk0dfr0xeh","lenses": [],"on_front_page": false,"published_at": "2026-10-24T20:51:18Z","rank_score": 1.196991,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-world","source_kind": "reporting","source_name": "CNA","source_url": "https://channelnewsasia.com/world/thousands-protest-in-italy-under-heavy-security-6489781","summary": "Security forces were deployed across Italy on Saturday (Oct 24) for protests in which thousands rallied despite a heavy crackdown following violent clashes last weekend. Police said they arrested nine people and briefly detained 371 more, including 110 minors, taken to stations in eight cities as clashes broke out at some rallies. Student groups have been highly critical of the government's public order response and urged it to address demands such as cuts to military spending in favour of education.","time_source": "feed","title": "Italian police deploy heavily as thousands protest amid crackdown","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-9qhcvy4bg9hfefeg","lenses": [],"on_front_page": false,"published_at": "2026-10-24T20:51:03Z","rank_score": 1.196895,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "euronews","source_kind": "reporting","source_name": "Euronews","source_url": "https://euronews.com/video/2026/10/24/young-protesters-clash-with-police-on-rome-streets","summary": "Clashes broke out between young protesters and police in Rome on Saturday, 24 October, amid ongoing demonstrations over the cost of living, wages and public services. Security forces were deployed in large numbers as tensions escalated in the capital. The protests are part of a wider wave of youth-led demonstrations demanding better living conditions and higher wages. In Milan, around 3,000 people also took to the streets, bringing traffic in the city centre to a standstill.","time_source": "feed","title": "Youth Protests Escalate in Rome and Milan","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-yarnh3v6zbw1fya9","lenses": [],"on_front_page": false,"published_at": "2026-10-24T20:46:57Z","rank_score": 1.195327,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "euronews","source_kind": "reporting","source_name": "Euronews","source_url": "https://euronews.com/2026/10/24/protests-sweep-across-europe-from-france-to-albania-italy-spain-and-portugal","summary": "Violence in earlier protests prompted heavy police and soldier deployments across European capitals, where thousands demonstrated over pensions, housing, education, corruption and opposition to war. In France around 2,400 people were arrested while nearly 1000 security forces members were injured; Paris alone saw about 100 protesters and residents hurt. Albania reported more than 300 injuries after clashes in Tirana, and Italy recorded nine arrests plus brief detention of 371 across eight cities.","time_source": "feed","title": "Protests Sweep Across Europe Amid Clashes","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
