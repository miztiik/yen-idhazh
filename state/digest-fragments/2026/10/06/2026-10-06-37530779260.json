    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["anthropic"],"events": ["funding","research"],"introduced_by_run": 1,"item_id": "business-economy-qr6p0zmmf86tb4nx","lenses": ["cyber"],"on_front_page": false,"published_at": "2026-10-06T19:03:24Z","rank_score": 1.656215,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/anthropic-opens-its-most-powerful-ai-models-more-security-teams-6437486","summary": "Anthropic announced on October 6 the expansion of its Cyber Verification Program, combining two initiatives to allow vetted cybersecurity professionals to test its most powerful AI models with fewer safeguards. The move follows the discovery of over 100,000 software vulnerabilities by the previous Project Glasswing initiative and Anthropic's own scanning efforts. The revamped program offers three tiers with varying access levels to models like Claude Opus 5.5 and Sonnet 5.5, requiring vetting by Anthropic and the US government.","time_source": "feed","title": "Anthropic Expands AI Security Testing Program","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 2,"desk": null,"entities": [],"events": ["funding"],"introduced_by_run": 1,"item_id": "india-jd6yx6ypsnfk0wzs","lenses": ["chips"],"on_front_page": false,"published_at": "2026-10-06T17:06:45Z","rank_score": 1.666093,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "toi-india","source_kind": "reporting","source_name": "Times of India - India","source_url": "https://timesofindia.indiatimes.com/india/barricade-stunt-chips-9-hour-dharna-and-detentions-all-that-happened-at-rahul-gandhi-led-cec-protest/articleshow/134746114.cms","summary": "High drama unfolded in New Delhi as INDIA bloc MPs, led by Rahul Gandhi, marched to the Election Commission demanding Chief Election Commissioner Gyanesh Kumar's resignation. The protest targeted the Special Intensive Revision exercise, which opposition parties allege disenfranchises eligible voters. After being denied a meeting, leaders staged a nine-hour sit-in at Akashvani Bhavan. Delhi Police detained Rahul Gandhi, Priyanka Gandhi Vadra, and others. The BJP accused the opposition of creating anarchy, while Congress condemned the detentions as a sign of a regime facing imminent exit. The Election Commission clarified that no formal meeting request was received until police informed them of the delegation's presence.","time_source": "feed","title": "Opposition Leaders Protest EC Over Voter Roll Changes","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": false},
