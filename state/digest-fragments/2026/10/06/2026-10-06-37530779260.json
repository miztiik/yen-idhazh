    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["tesla"],"events": ["acquisition","release"],"introduced_by_run": 1,"item_id": "energy-4cbr3xxea9b1zcv0","lenses": [],"on_front_page": false,"published_at": "2026-10-06T18:54:46Z","rank_score": 1.653141,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "greentech","source_kind": "reporting","source_name": "Solar Power World","source_url": "https://solarpowerworldonline.com/2026/10/teslas-full-ev-lineup-can-now-also-provide-home-backup-energy","summary": "Tesla announced that AC bidirectional charging capabilities are now available for new Model 3 and Model Y vehicles paired with the Powerwall 3 home battery. Previously restricted to Cybertruck owners, the Powershare Home Backup program now allows these models to extend backup duration. Colby Hastings, Tesla's Senior Director of Residential Energy, stated that choosing a Tesla is now a decision to invest in home energy resilience.","time_source": "feed","title": "Tesla Expands Powershare Home Backup to Model 3 and Model Y","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "energy","visual": null,"watchlist_hit": true},
