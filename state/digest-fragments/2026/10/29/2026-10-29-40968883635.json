    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","federal-reserve","google"],"events": ["acquisition","capex","earnings","release"],"introduced_by_run": 1,"item_id": "ai-1whgemz19q7c3kyy","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-29T21:09:26Z","rank_score": 2.011974,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "straitstimes-business","source_kind": "reporting","source_name": "The Straits Times","source_url": "https://straitstimes.com/business/companies-markets/wall-street-ends-lower-as-alphabet-revenue-miss-revives-ai-capex-jitters","summary": "US stocks fell on Oct 29 after Alphabet\u2019s revenue miss and accelerated AI cash burn revived concerns about big-tech spending, with the Nasdaq down 1.37% to 26,184.72 and the Dow lower by 0.25%. The Russell 2000 rose 1%, and Fed officials held rates steady on Oct 28 amid elevated price pressures as investors weighed AI valuations against other sectors.","time_source": "feed","title": "US Stocks Slide as Alphabet Miss Revives AI Spending Fears","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "hedge_dropped","carried_by": 1,"desk": null,"entities": ["amazon","google","microsoft","openai"],"events": ["earnings"],"introduced_by_run": 1,"item_id": "ai-f1xwjykhtdfmkerc","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-29T22:17:52Z","rank_score": 1.687206,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "bbc-tech","source_kind": "reporting","source_name": "BBC - Technology","source_url": "https://bbc.co.uk/news/articles/cm9qzdqpxy48o?at_campaign=rss&at_medium=RSS","summary": "Google parent Alphabet lost just over $500bn (\u00a3374bn) in value on Thursday after its latest quarterly update rattled Wall Street. Total revenue rose 25% to $127.6bn, helped by Google Cloud growth of 103% to almost $31bn, but profits fell 25% and free cash flow turned negative at over $9bn. Investors were dismayed that AI spending is pressuring core search ad revenue, the bulk of Alphabet's business. Forrester analyst Tracy Woo said results highlight funding massive AI investments while sustaining established businesses. Amazon shares also fell 6%, with CEO Andy Jassy citing two future trillion-dollar opportunities in chips and Bedrock. Microsoft shares dropped under 1% as it cut jobs amid strong cloud growth to $63bn, though Satya Nadella noted Copilot use nearly doubled since July.","time_source": "feed","title": "Alphabet's AI Spending Triggers $500bn Value Drop","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["anthropic","openai"],"events": ["release"],"introduced_by_run": 1,"item_id": "ai-h24senevm078vkqw","lenses": [],"on_front_page": false,"published_at": "2026-10-29T22:48:29Z","rank_score": 1.668859,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "simon-willison","source_kind": "analysis","source_name": "Simon Willison","source_url": "https://simonwillison.net/2026/Oct/29/api-credits","summary": "On 29th October 2026, the author of a Link Blog post reported that OpenAI had launched an offer mirroring one announced earlier by Anthropic. Subscribers to $100, $200 and $500 monthly plans would receive credits equivalent in quantity to their subscription amount for use with the API. The writer holds subscriptions with both companies and said the benefit could enable public-facing demos.","time_source": "feed","title": "OpenAI matches Anthropic with API credit benefit for top ChatGPT plans","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","google"],"events": ["earnings","funding","release"],"introduced_by_run": 1,"item_id": "ai-ttw3b6wsr343p88c","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-29T21:23:02Z","rank_score": 1.6669,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "guardian-ai","source_kind": "reporting","source_name": "The Guardian - AI","source_url": "https://theguardian.com/technology/2026/oct/29/amazon-earnings-report-mixed-picture","summary": "Amazon delivered a mixed financial picture Thursday as its cloud unit AWS grew 39.3%, the fastest rate in nearly five years, while core sales fell short of Wall Street expectations and shares dropped more than 6%. The company forecast Q4 net sales between $240bn and $247bn, above analyst estimates near $244.16bn.","time_source": "feed","title": "Amazon Posts Mixed Cloud Strength, Weak Core Sales in Earnings","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["amazon","apple","openai"],"events": ["acquisition"],"introduced_by_run": 1,"item_id": "ai-a8mhf1chw09twsqt","lenses": [],"on_front_page": false,"published_at": "2026-10-29T19:56:19Z","rank_score": 1.546211,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "techcrunch-ai","source_kind": "reporting","source_name": "TechCrunch - AI","source_url": "https://techcrunch.com/2026/10/29/openai-backed-thrive-holdings-acquires-adt","summary": "Thrive Holdings, a spinout from Josh Kushner's Thrive Capital with OpenAI as partner and investor, acquired physical security company ADT on Thursday. The deal prices at $10 per share or about $7.6 billion in equity, the companies announced. Beyond equity, total enterprise value reaches $15.3 billion, ADT said. Neither side disclosed new AI-powered products yet, though they teased plans to invest and release them going forward.","time_source": "feed","title": "OpenAI-Backed Thrive Holdings Buys ADT for $7.6 Billion in Equity","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "ai-c0vvky9y8x12hsba","lenses": ["china","markets"],"on_front_page": false,"published_at": "2026-10-29T22:00:00Z","rank_score": 1.530511,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "straitstimes-business","source_kind": "reporting","source_name": "The Straits Times","source_url": "https://straitstimes.com/business/you-dont-need-to-be-a-natural-salesperson-to-be-a-banker-bank-of-singapore-ceo","summary": "Jason Moo, chief executive of Bank of Singapore (BOS), told The Straits Times that success in private banking depends on trust and lasting client relationships rather than any particular personality type. He said bankers often mirror their clients\u2019 personalities, so banks should keep a diverse pool to match varied preferences. Moo added that bankers need not be natural salespeople; both broad networking and deep one-on-one engagement can succeed if the relationship is strong. The comments come as BOS expects to add hundreds of private bankers over the next few years after reaching its target of 500 globally by end-2024, with AUM surpassing US$145 billion in 2025.","time_source": "feed","title": "Bank of Singapore Chief Says Trust, Not Personality Type, Defines a Great Banker","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["incident","release"],"introduced_by_run": 1,"item_id": "ai-0hyz73g3c8c473ty","lenses": [],"on_front_page": false,"published_at": "2026-10-29T22:30:04Z","rank_score": 1.491822,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "databricks-blog","source_kind": "announcement","source_name": "Databricks","source_url": "https://databricks.com/blog/announcing-general-availability-real-time-mode-spark-declarative-pipelines-databricks","summary": "Databricks announced that Real-Time Mode (RTM) is now generally available within Spark Declarative Pipelines, letting customers build low-latency streaming and ETL pipelines with a single framework. RTM streams data continuously, runs all query stages simultaneously, and passes data between stages as soon as it is produced to reach millisecond-range end-to-end latency. Databricks benchmarked RTM against Apache Flink on customer feature-computation workloads and reported up to 92% faster performance than specialized engines like Flink. The announcement highlights use cases such as fraud detection, live personalization, real-time recommendations, and the Databricks Feature Store's p99 latency of 200ms from Kafka to an online store.","time_source": "feed","title": "Databricks Generalizes Real-Time Mode in Spark Declarative Pipelines","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["federal-reserve"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-az4h78kxwdk1293n","lenses": [],"on_front_page": false,"published_at": "2026-10-29T20:30:00Z","rank_score": 2.043028,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "fed-press","source_kind": "government","source_name": "US Federal Reserve","source_url": "https://federalreserve.gov/newsevents/pressreleases/orders20261029a.htm","summary": "On October 29, 2026, the Federal Reserve Board announced its approval of The Bank of Nova Scotia's application to become a bank holding company. This would allow it to acquire Maple Financial Holdings, Inc., based in Dallas, Texas, and thereby indirectly gain control of MapleMark Bank in Tulsa, Oklahoma. The announcement was released at 4:30 p.m. EDT on Thursday.","time_source": "feed","title": "Federal Reserve Board Approves Bank of Nova Scotia Holding Company Application","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "hedge_dropped","carried_by": 1,"desk": null,"entities": ["amd","google","intel","nvidia"],"events": ["earnings"],"introduced_by_run": 1,"item_id": "business-economy-9wpyjn92mpkdbvgp","lenses": ["chips","markets"],"on_front_page": false,"published_at": "2026-10-29T21:02:58Z","rank_score": 1.629646,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/weak-quarter-intel-sends-shivers-through-cooling-chip-stocks-6504986","summary": "Chip stocks fell after Intel reported weak quarterly earnings, citing near-term PC industry headwinds. Its shares dropped 18% in after-hours trading on October 29, 2026. The report followed Alphabet's disappointing results and a factory explosion in Israel costing Intel roughly $600 million over two quarters.","time_source": "feed","title": "Intel's Weak Earnings Trigger Cooling Chip Stock Sell-Off","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["amazon","google","microsoft"],"events": ["capex"],"introduced_by_run": 1,"item_id": "business-economy-cf2c6nv9p5p82qrz","lenses": ["markets"],"on_front_page": false,"published_at": "2026-10-29T20:08:53Z","rank_score": 1.610554,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/amazon-slides-light-fourth-quarter-sales-estimates-high-cash-burn-6504886","summary": "Amazon reported a large cash burn in the third quarter and forecast fourth-quarter revenue between $240.0 billion and $247.0 billion, below analysts' average estimate of $244.51 billion per LSEG data. Capital expenditure reached $77.26 billion, about $20 billion above estimates. Shares fell nearly 7 per cent in extended trading as investors weighed the outlook amid heavy AI spending commitments and disappointing advertising growth of 12 per cent to $19.6 billion.\n\nvisual null},","time_source": "feed","title": "Amazon Shares Fall on Weak Holiday Forecast and Heavy Cash Burn","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["google"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-9tvx1dpdx43ebtm8","lenses": ["markets"],"on_front_page": false,"published_at": "2026-10-29T22:42:27Z","rank_score": 1.606544,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "semafor","source_kind": "reporting","source_name": "Semafor","source_url": "https://semafor.com/article/10/29/2026/alphabet-loses-500bn-in-market-value","summary": "Alphabet's shares fell as much as 13% Thursday, erasing more than $500 billion in market value in the worst single-day performance for the Google parent company after it reported slowing search revenue growth. One analyst said the miss elevates fear around AI and agentic taking share from Search and YouTube, intensifying scrutiny of hyperscalers' big spending.","time_source": "feed","title": "Alphabet's Worst Single-Day Drop Erases $500 Billion","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "hedge_dropped","carried_by": 1,"desk": null,"entities": ["nvidia","openai"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-3k7gcbg3bzeqtm9j","lenses": ["china","chips"],"on_front_page": false,"published_at": "2026-10-29T22:36:37Z","rank_score": 1.604315,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "semafor","source_kind": "reporting","source_name": "Semafor","source_url": "https://semafor.com/article/10/29/2026/nvidia-chief-jensen-huang-targeted-in-alleged-spy-plot","summary": "The New York Times reported Thursday that a Chinese businesswoman close to Nvidia CEO Jensen Huang is suspected of passing intelligence to Beijing, rekindling fears over the security of US industrial secrets amid an intensifying global AI race. Nvidia dismissed the allegations as investigated and debunked.","time_source": "feed","title": "Nvidia Chief Targeted in Alleged Spy Plot","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "hedge_dropped","carried_by": 1,"desk": null,"entities": ["amazon"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-wpeyqav9558gv2qd","lenses": [],"on_front_page": false,"published_at": "2026-10-29T21:50:27Z","rank_score": 1.489696,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "quartz","source_kind": "reporting","source_name": "Quartz","source_url": "https://qz.com/amazon-aws-cloud-growth-fastest-earnings-102926","summary": "Amazon reported that Amazon Web Services revenue rose 39% to $46.0 billion in the third quarter, its quickest expansion in almost five years. The company said AWS is now growing at a pace totaling $184 billion over a full year.","time_source": "feed","title": "AWS sales jump 39% in fastest quarter in nearly five years","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["google","ibm","nvidia"],"events": ["earnings","funding"],"introduced_by_run": 1,"item_id": "business-economy-0yetpfdd2yct8af5","lenses": ["markets"],"on_front_page": false,"published_at": "2026-10-29T21:00:59Z","rank_score": 1.471666,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "quartz","source_kind": "reporting","source_name": "Quartz","source_url": "https://qz.com/single-day-stock-drops-2026-major-companies","summary": "A selection lists five major single-day stock drops in 2026, involving Alphabet, IBM, SpaceX and Caterpillar. Spending on artificial intelligence infrastructure appears in two of the declines: investors worried about Alphabet's AI spending, while IBM warned corporate customers were shifting budgets toward supply-constrained AI infrastructure. The list is a partial selection rather than a complete tally or ranking. SpaceX fell 16% in June during a multi-day selloff that erased roughly $400 billion; its single-day portion is not broken out. Alphabet dropped 7% on July 23 and nearly 13% on October 30, erasing about $482 billion after third-quarter revenue of $127.6 billion missed expectations. Caterpillar sank 9.3% the same day; its $20.7 billion in revenue trailed Wall Street's $20.8 billion by $0.1 billion despite strong energy and power results. No explanation for the selloff scale is on record.","time_source": "feed","title": "Five Largest Single-Day Stock Drops of 2026","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["intel"],"events": ["capex","earnings"],"introduced_by_run": 1,"item_id": "world-m7mj3091djwe66wq","lenses": ["chips"],"on_front_page": false,"published_at": "2026-10-29T20:39:55Z","rank_score": 1.861428,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "anadolu-world","source_kind": "reporting","source_name": "Anadolu Agency","source_url": "https://aa.com.tr/en/world/us-chipmaker-intel-posts-21-revenue-jump-in-q3-on-data-center-demand/4105484","summary": "US chipmaker Intel reported a 21% year-on-year increase in third-quarter revenue to $16.5 billion, topping company guidance. Its Data Center and AI group surged 78% to $7.3 billion, the fastest growth in 15 years, while Client Computing fell 5% amid PC weakness. Net income dropped 18% on a GAAP basis but rose sharply on an adjusted measure. CEO Lip-Bu Tan cited improving execution and robust CPU demand; CFO David Zinsner warned that personal computer slowdown is expected to continue through at least the first half of 2027.","time_source": "feed","title": "Intel reports strong Q3 revenue driven by data center and AI demand","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["amazon","ecb","google","intel","microsoft"],"events": ["capex","earnings","funding"],"introduced_by_run": 1,"item_id": "world-f9s1h9dp4qckm9t0","lenses": ["cyber","markets"],"on_front_page": false,"published_at": "2026-10-29T21:16:19Z","rank_score": 1.604462,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "abc-au-world","source_kind": "reporting","source_name": "ABC News Australia","source_url": "https://abc.net.au/news/2026-10-30/asx-markets-business-live-news-oct-30/107326558","summary": "The Australian share market is likely to rise modestly on opening, with ASX 200 futures up 15 points overnight. Google parent company Alphabet lost more than half a trillion US dollars amid worries AI would subsume its advertising business in the largest one-day fall in the company's history. NAB strategist Gavin Friend said a 'fresh wave of anxiety over AI' followed disappointing third-quarter earnings, with shares tumbling 12.6% as capital expenditure concerns raised questions about profitability. The sell-off dragged the Nasdaq down 1.5%, while US economic data reinforced expectations for higher interest rates. Local investors are watching whether market breadth narrows ahead of RBA rate decisions next week.","time_source": "feed","title": "ASX set to edge up despite Alphabet share slump","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["amazon"],"events": ["acquisition","earnings","regulation"],"introduced_by_run": 1,"item_id": "world-8ndxsgaxt4cpywww","lenses": ["china","markets"],"on_front_page": false,"published_at": "2026-10-29T18:47:56Z","rank_score": 1.583187,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "mongabay","source_kind": "reporting","source_name": "Mongabay","source_url": "https://news.mongabay.com/2026/10/in-surinames-amazon-the-wayana-community-struggling-to-keep-gold-miners-at-bay","summary": "In Suriname, the government has pledged to combat illegal mining and mercury use while maintaining 90% national forest cover. Yet along its border with French Guiana, Indigenous Wayana communities face decades of unregulated gold extraction that deforests land and pollutes rivers. Kawemhakan's chief Ipomadi Toko Pelenap\u00efn controls the region's only airstrip, giving him leverage over miners who must pass through his village. Mongabay's analysis by Monitoring of the Andean Amazon Project found at least 25,000 hectares lost between 2021 and 2024, with another 2,800 hectares deforested last year. The Spence family once extorted miners before disappearing; their operations now fall to Canadian company Founders Metals. With no land title and little government presence, the Wayana look toward education initiatives led by the Mulokot Foundation for a future beyond gold.","time_source": "feed","title": "Suriname's Wayana Chief Battles Illegal Gold Miners in Remote Amazon Borderlands","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 2,"desk": null,"entities": ["rbi"],"events": [],"introduced_by_run": 1,"item_id": "india-vx0168j0yyy2j7t4","lenses": [],"on_front_page": false,"published_at": "2026-10-29T20:52:48Z","rank_score": 1.816006,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "toi-india","source_kind": "reporting","source_name": "Times of India - India","source_url": "https://timesofindia.indiatimes.com/india/mandate-damages-for-savings-lost-in-digital-arrest-sc-to-rbi/articleshow/135331961.cms","summary": "The Supreme Court directed the Reserve Bank of India that its proposed standard operating procedure must require banks to compensate victims who lose money kept with them through digital-arrest frauds, citing possible complicity by bank staff. The court referenced a Nov 30 procedure and framed the directive as mandatory.","time_source": "feed","title": "Supreme Court Orders Banks to Compensate Digital-Arrest Fraud Victims","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": true}
