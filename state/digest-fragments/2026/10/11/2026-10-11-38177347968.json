    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": ["deal"],"introduced_by_run": 1,"item_id": "ai-eewd7ghg69vf6e01","lenses": [],"on_front_page": false,"published_at": "2026-10-11T21:00:00Z","rank_score": 1.584249,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "straitstimes-business","source_kind": "reporting","source_name": "The Straits Times","source_url": "https://straitstimes.com/business/askst-jobs-i-keep-having-to-pick-up-a-colleagues-work-how-should-i-raise-it-with-my-boss","summary": "Timothy Goh of The Straits Times presents advice on addressing uneven workloads. Michelle Koh of The Edge Partnership suggests raising issues calmly with specific examples focused on work impact rather than personal attacks. Tan Weixi of Workplace Asia warns against framing the issue as a judgment on a colleague's effort, recommending instead that employees highlight work problems and ask for solutions while avoiding making the boss referee between staff.","time_source": "feed","title": "Experts Advise on Raising Workload Concerns Without Blaming Colleagues","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "ai-xkdm21vj6qdj3840","lenses": [],"on_front_page": false,"published_at": "2026-10-11T21:00:00Z","rank_score": 1.584249,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "straitstimes-opinion","source_kind": "reporting","source_name": "The Straits Times","source_url": "https://straitstimes.com/opinion/forum/forum-are-loan-limits-and-financing-arrangements-sufficient-to-promote-prudent-borrowing","summary": "Recent reports highlight concerns that vehicle financing arrangements in Singapore, including 100% loans and exemptions for Grab drivers, may encourage excessive debt. With household motor-vehicle loans reaching about $12.4 billion at the end of 2025, a 12-year high, and Category A COE premiums hitting a record $133,009, authorities are urged to ensure these measures do not undermine financial discipline.","time_source": "feed","title": "Singapore regulators urged to review vehicle financing safeguards","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "ai-e20bze7p5r20w6xt","lenses": [],"on_front_page": false,"published_at": "2026-10-11T21:00:00Z","rank_score": 1.584249,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "straitstimes-opinion","source_kind": "reporting","source_name": "The Straits Times","source_url": "https://straitstimes.com/opinion/forum/forum-brain-health-should-be-part-of-preventive-care","summary": "Health Minister Ong Ye Kung stated that Singapore is shifting toward preventive, predictive, and personalised healthcare, with brain health as a key component. He noted that dementia risks develop years before symptoms appear and can be influenced by modifiable factors like diet and inactivity. The government plans to incorporate brief brain health conversations into midlife health plan reviews, leveraging existing data on conditions like hypertension to guide patients toward realistic lifestyle changes without requiring universal screening.","time_source": "feed","title": "Singapore to Integrate Brain Health into Preventive Care Strategy","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["openai"],"events": ["capex","regulation","research"],"introduced_by_run": 1,"item_id": "ai-smdkc9xfh0v9a6q4","lenses": [],"on_front_page": false,"published_at": "2026-10-11T14:12:09Z","rank_score": 1.449694,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "techpolicy-ai","source_kind": "reporting","source_name": "TechPolicy","source_url": "https://techpolicy.press/a-data-science-playbook-for-social-justice","summary": "Ben Green, an assistant professor at the University of Michigan, argues that traditional data science metrics often fail to reflect real-world social impacts. In his book, \"Algorithmic Realism: Data Science Practices to Promote Social Justice,\" he introduces a methodology that prioritizes practical outcomes over technical accuracy. Drawing on his experience with a Memphis urban planning project, Green illustrates how systems can fail due to institutional and political barriers rather than algorithmic flaws. He contrasts his approach with \"algorithmic formalism,\" which relies on statistical metrics, advocating instead for a \"pragmatist maxim\" where an algorithm's value is determined by its actual effects. Green suggests data scientists should view themselves as political actors and strategists who integrate ethics into practice. He calls for regulatory changes and funding for public sector research to shift the industry away from profit-driven models toward community-centered development, ensuring AI serves the public interest rather than just optimizing for abstract benchmarks.","time_source": "feed","title": "Ben Green Proposes Algorithmic Realism for Social Justice in Data Science","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
