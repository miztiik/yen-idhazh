    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "faithfulness","carried_by": 1,"desk": null,"entities": ["openai"],"events": ["release"],"introduced_by_run": 1,"item_id": "ai-axcq39hwmcm08g6c","lenses": [],"on_front_page": false,"published_at": "2026-10-22T19:00:00Z","rank_score": 1.639693,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "techcrunch-ai","source_kind": "reporting","source_name": "TechCrunch - AI","source_url": "https://techcrunch.com/2026/10/22/openai-makes-its-jev-competitor-widely-available-as-decision-model-competition-heats-up","summary": "OpenAI launched its Decisions API, a fast, low-cost decision model, to all customers following its announcement at a developer day. The tool aims to replace larger language models in workflows by reducing inference time from seconds to milliseconds. Early trials with companies like Speak showed significant speed improvements, while OpenAI noted the model currently leverages existing technology rather than a specifically calibrated system.","time_source": "feed","title": "OpenAI launches widely available Decisions API model","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["anthropic","deepseek","google","microsoft","openai"],"events": ["acquisition","deal","funding","release","research"],"introduced_by_run": 1,"item_id": "ai-vvfjh5qcvd5baa67","lenses": [],"on_front_page": false,"published_at": "2026-10-22T18:43:53Z","rank_score": 1.634139,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "techcrunch-ai","source_kind": "reporting","source_name": "TechCrunch - AI","source_url": "https://techcrunch.com/2026/10/22/microsofts-mustafa-suleyman-says-its-ai-outperforms-doctors-on-hard-cases-as-he-chases-medical-superintelligence","summary": "Microsoft's AI diagnostic system, MAI-DxO, correctly diagnosed complex medical cases in a simulation more than twice as often as generalist physicians, according to a study published in Science. The system, which coordinates several AI agents, achieved an 83% accuracy rate on complex cases compared to 36% for human doctors. While the system showed significant improvements with certain AI models like GPT-5.5 and Gemini 2.5 Flash, gains were less pronounced on emergency department cases. Microsoft plans to evaluate the system's clinical reasoning capabilities in real-world hospital settings through a partnership with Beth Israel Deaconess Medical Center.","time_source": "feed","title": "Microsoft AI System Outperforms Doctors in Complex Medical Simulations","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["tesla"],"events": ["earnings","incident","regulation"],"introduced_by_run": 1,"item_id": "energy-j5vqg2ssczr6abdp","lenses": ["china","markets"],"on_front_page": false,"published_at": "2026-10-22T21:23:05Z","rank_score": 1.6916,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "electrek","source_kind": "reporting","source_name": "Electrek","source_url": "https://electrek.co/2026/10/22/tesla-skipped-hw3-shareholder-question-earnings-call","summary": "Tesla omitted a top-ranked shareholder inquiry regarding a free hardware upgrade for Full Self-Driving during its Q3 2026 earnings call. The question, which received 557 votes and 652,900 shares, asked when owners would receive a free computer upgrade for unsupervised FSD. While Tesla addressed other topics, including Optimus revenue and FSD timelines, it did not mention Hardware 3, AI3, or retrofits. Head of AI Ashok Elluswamy noted that unsupervised FSD would arrive in customer cars around Q2 2027, but this timeline excludes millions of existing Hardware 3 owners who paid up to $15,000 for the feature. Analysts and observers suggest this silence may be a legal strategy to avoid admitting liability in ongoing class actions across the US, China, Australia, and the Netherlands.","time_source": "feed","title": "Tesla Skips Shareholder Question on HW3 FSD Upgrade","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "energy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["tesla"],"events": ["earnings","release"],"introduced_by_run": 1,"item_id": "energy-6gthzhxg6q8vh4x6","lenses": [],"on_front_page": false,"published_at": "2026-10-22T20:03:18Z","rank_score": 1.66207,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "electrek","source_kind": "reporting","source_name": "Electrek","source_url": "https://electrek.co/2026/10/22/tesla-building-own-maps-fsd-after-mocking-maps","summary": "Tesla announced it is building its own maps to address limitations in its Full Self-Driving system, specifically regarding speed limits, parking, and route selection. Ashok Elluswamy, Tesla's VP of AI, stated this effort began on the Q3 2026 earnings call, marking a departure from years of dismissing map reliance. The company aims to use fleet data to create a map layer, similar to Waymo but without lidar. This shift follows reports that FSD failed to correctly identify speed limits in Brussels and faces potential NHTSA investigation regarding Robotaxi speeds. Tesla plans to integrate this technology starting with FSD v15.","time_source": "feed","title": "Tesla Shifts Strategy to Build Own Maps for FSD","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "energy","visual": null,"watchlist_hit": true},
