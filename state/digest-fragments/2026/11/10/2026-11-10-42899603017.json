    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["nvidia"],"events": [],"introduced_by_run": 1,"item_id": "india-x937w38tftrm18cy","lenses": ["china","chips","cyber"],"on_front_page": false,"published_at": "2026-11-10T17:29:47Z","rank_score": 1.596143,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "economic-times","source_kind": "reporting","source_name": "The Economic Times","source_url": "https://economictimes.indiatimes.com/news/international/business/what-we-know-and-what-we-dont-as-nvidia-investigates-an-alleged-spy-plot-involving-its-ceo/articleshow/135717578.cms","summary": "Jensen Huang admitted over the weekend to an extramarital affair and acknowledged that reports tied to national security concerns prompted Nvidia's board to investigate. The New York Times identified his partner as Alice Huang, a former executive of Singapore-based Megaspeed International whom U.S. intelligence said was feeding information to Beijing. China dismissed the allegations as a smear campaign. Nvidia's board found no evidence of compromise and confirmed Huang would remain CEO while cooperating with the inquiry. Huang apologized in an email to employees, reaffirming his support for national security. The scandal raises questions about export controls on AI chips sold to China.","time_source": "feed","title": "Nvidia CEO Jensen Huang Faces Spy Allegations After Affair Admission","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": true},
