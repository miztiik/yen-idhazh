    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["google","samsung"],"events": ["release"],"introduced_by_run": 1,"item_id": "ai-zbzz8a9c17ys6w65","lenses": ["chips"],"on_front_page": false,"published_at": "2026-11-10T19:00:00Z","rank_score": 2.007507,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "google-ai-blog","source_kind": "announcement","source_name": "Google - AI","source_url": "https://blog.google/products-and-platforms/platforms/android/gemini-intelligence-november-features-devices","summary": "Google introduced new capabilities for its Gemini Intelligence system on additional Android phones, including the first Motorola device and updated Pixel models. Rambler 4 now appears on several Pixels plus the new motorola signature 27, while task automation expands to the UK, India, and Japan. Create My Widget is rolling out over coming weeks, with Device Assistance offering hands-free help across screens.","time_source": "feed","title": "Google rolls out Gemini Intelligence features across more Android devices","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "low","band_reason": "faithfulness","carried_by": 2,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "ai-r7es7a7mcte2k7kt","lenses": ["cyber","trade","war"],"on_front_page": false,"published_at": "2026-11-10T18:37:42Z","rank_score": 1.699585,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "normaltech-ai","source_kind": "research","source_name": "AI as Normal Technology","source_url": "https://normaltech.ai/p/the-missing-quadrant-in-responses","summary": "The founders of the new non-profit research organization STABL announced its launch, outlining a worldview organized around two axes: taking advanced AI's transformative potential seriously versus taking downstream bottlenecks to its impacts seriously. They place their work in the top-right quadrant they describe as underserved and polarizing, where both technological optimism and institutional conservatism are taken seriously but little analysis occurs. STABL plans empirical research on recursive self-improvement through a project called CRUX, expanded AI safety responses beyond alignment and non-proliferation with emphasis on resilience, studies of economic impacts including augmentation versus automation, and sector-specific analyses of professions like science, legal services, and software engineering. The organization is actively fundraising and hiring across four workstreams and has assembled an advisory board of experts in AI's societal impacts.","time_source": "feed","title": "STABL Launches Research on AI's Transformative Potential and Downstream Bottlenecks","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": false},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": "ai","entities": ["nvidia"],"events": [],"introduced_by_run": 1,"item_id": "ai-kn124fxm4ewxqv89","lenses": ["china","chips"],"on_front_page": false,"published_at": "2026-11-10T20:40:13Z","rank_score": 1.694544,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "bbc-tech","source_kind": "reporting","source_name": "BBC - Technology","source_url": "https://bbc.co.uk/news/articles/ck1wvwwl3x0go?at_campaign=rss&at_medium=RSS","summary": "Nvidia has hired New York law firm Wachtell, Lipton, Rosen & Katz to investigate the affair between its chief executive and an alleged Chinese spy. Attorney Joon Kim is set to lead a thorough and independent investigation into Jensen Huang's relationship with Alice Huang, an executive at Nvidia customer Megaspeed who is believed by US officials to be spying for Beijing. Nvidia shares fell more than $500bn (\u00a3375bn) on Tuesday amid the fallout.","time_source": "feed","title": "Nvidia Hires Wachtell To Probe Jensen Huang Alleged Spy Affair","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "medium","band_reason": "hedge_dropped","carried_by": 1,"desk": null,"entities": ["oracle"],"events": [],"introduced_by_run": 1,"item_id": "ai-t2g6xhz06xkfnfbn","lenses": ["chips","cyber","markets"],"on_front_page": false,"published_at": "2026-11-10T20:30:01Z","rank_score": 1.660665,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "ars-technica-ai","source_kind": "reporting","source_name": "Ars Technica - AI","source_url": "https://arstechnica.com/science/2026/11/what-happens-to-mathematics-when-ai-becames-an-oracle","summary": "Applied mathematicians Steven Strogatz and Alex Townsend have written a new book, Big Math: The Hidden Codes That Run Our World. It examines how large-scale mathematics now exceeds human mental capacity but is handled by computers. The authors argue that externalizing math into tools like the abacus or matrix boards reflects ideas centuries old.","time_source": "feed","title": "Strogatz and Townsend Explore Big Math in New Book","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["google"],"events": [],"introduced_by_run": 1,"item_id": "ai-bfv11mexfp718rw2","lenses": ["cyber"],"on_front_page": false,"published_at": "2026-11-10T20:09:44Z","rank_score": 1.653025,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "simon-willison","source_kind": "analysis","source_name": "Simon Willison","source_url": "https://simonwillison.net/2026/Nov/10/llm-gemini","summary": "On November 10, 2026, Google made Gemini 4 Carbon available to everyone after its initial launch for a subset of cyber defenders. The model is priced at $2 per million input tokens and $10 per million output tokens, with prices scheduled to double to $4/$20 on December 1st. A tester demonstrated it using the Antigravity IDE with an animation prompt.","time_source": "feed","title": "Google makes Gemini 4 Carbon available beyond cyber defenders","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": "ai","entities": [],"events": [],"introduced_by_run": 1,"item_id": "ai-nsa3zq38yz5jca6m","lenses": ["cyber"],"on_front_page": false,"published_at": "2026-11-10T20:52:13Z","rank_score": 1.609141,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "techcrunch-ai","source_kind": "reporting","source_name": "TechCrunch - AI","source_url": "https://techcrunch.com/2026/11/10/openai-anthropic-face-new-oversight-as-new-yorks-ai-safety-law-takes-effect","summary": "New York is enforcing its RAISE Act, requiring large frontier AI developers like Anthropic and OpenAI to register by January 1, 2027. Companies with more than $500 million in annual revenue must publish safety frameworks, report critical incidents within 72 hours, and issue transparency reports. The newly formed DIGIT office will implement the law, with penalties up to $3 million for repeat violations. Governor Kathy Hochul also launched a research center at Binghamton University to evaluate AI systems independently.","time_source": "feed","title": "New York Enforces Landmark AI Safety Law","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "ai","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["tesla"],"events": [],"introduced_by_run": 1,"item_id": "energy-mxzbeznaq82bgy00","lenses": [],"on_front_page": false,"published_at": "2026-11-10T20:45:45Z","rank_score": 1.606659,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "electrek","source_kind": "reporting","source_name": "Electrek","source_url": "https://electrek.co/2026/11/10/tesla-cybertruck-had-its-best-month-in-over-a-year-its-still-going-away","summary": "New EV prices edged up in October, but buyers still paid less than they did a year ago. The average transaction price for a new EV in the US was $56,220, per Kelley Blue Book, a Cox Automotive brand. Tesla's Cybertruck helped push its average selling price higher; Cox Automotive estimates 1,914 sold at an average of $92,380, its best month in more than a year. Tesla plans to end production and dismantle the Austin assembly line around June or July 2027 for robotaxis.","time_source": "feed","title": "Tesla Cybertruck sales hit best month in over a year","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "energy","visual": null,"watchlist_hit": true},
    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": ["federal-reserve","nvidia"],"events": [],"introduced_by_run": 1,"item_id": "business-economy-tvk4a7wk0q4sj6bs","lenses": ["markets"],"on_front_page": false,"published_at": "2026-11-10T20:46:05Z","rank_score": 1.666787,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "cna-business","source_kind": "reporting","source_name": "CNA Business","source_url": "https://channelnewsasia.com/business/nvidia-selloff-deepens-adding-ai-jitters-6540636","summary": "Technology shares fell again on Tuesday, led by a sharp drop in Nvidia after it hired lawyers for an internal probe tied to its CEO. Selling was also pushed by a hot US inflation report raising expectations of another rate rise next month. The Nasdaq Composite slipped 1 per cent amid broader sector jitters, though investors remained focused on upcoming earnings and Anthropic's IPO rather than the short-term volatility.","time_source": "feed","title": "Tech Shares Fall as Nvidia Selloff Fuels AI Anxiety","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "business-economy","visual": null,"watchlist_hit": true},
