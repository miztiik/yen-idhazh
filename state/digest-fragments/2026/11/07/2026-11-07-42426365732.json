    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "world-qy9qq2ecvvhj8nrg","lenses": [],"on_front_page": false,"published_at": "2026-11-07T23:00:00Z","rank_score": 1.153861,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "japan-times","source_kind": "reporting","source_name": "The Japan Times","source_url": "https://japantimes.co.jp/life/2026/11/08/food-drink/curry-roux-cube-recipe-kakushi-aji-hidden-flavor","summary": "The article shares a recipe for homemade curry roux cubes, explaining that Japanese curry\u2014adapted from the British navy in the late 19th century\u2014is often derided as \u201cB-class\u201d cuisine but has become its own paradigm. It highlights kakushi aji (\u201chidden flavors\u201d) like apple, honey, soy sauce and miso, which elevate dishes without overt heat. The base recipe contains no chile, though cooks may adjust spice freely. Each cube yields approximately 550 milliliters of curry for four adults; the finished cubes keep refrigerated over a month or frozen up to six months.","time_source": "feed","title": "A Home Recipe for Japanese Curry Roux Cubes With Hidden Flavors","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "world","visual": null,"watchlist_hit": false},
