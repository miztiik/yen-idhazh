    {"also_covered_by": null,"also_ran_earlier": [],"band": "high","band_reason": null,"carried_by": 1,"desk": null,"entities": [],"events": [],"introduced_by_run": 1,"item_id": "india-n4jdtf318e5wj5es","lenses": [],"on_front_page": false,"published_at": "2026-11-04T22:40:44Z","rank_score": 1.525331,"reader_note": null,"same_story_as": null,"secondary_desk": null,"source_form": "article","source_id": "free-press-journal","source_kind": "reporting","source_name": "Free Press Journal","source_url": "https://freepressjournal.in/mumbai/mumbai-western-railway-to-use-ticket-checkers-body-cam-footage-as-court-evidence-after-assaults-on-2-women-tcs","summary": "Mumbai's Western Railway will use body-camera recordings from ticket checkers (TCs) in court after two women TCs were allegedly assaulted at Kandivali and Andheri stations within three weeks. The railway launched a 15-day special drive deploying 15 cameras, catching around 1,400 passengers daily against the usual 300-odd. Officials plan to procure at least 1,000 more cameras costing about Rs 10,000 each and said recordings will also aid staff training.","time_source": "feed","title": "Western Railway Will Use Ticket Checkers' Body Cam Footage as Court Evidence","truncated": false,"updated_at": null,"updated_by_run": null,"vertical": "india","visual": null,"watchlist_hit": true},
