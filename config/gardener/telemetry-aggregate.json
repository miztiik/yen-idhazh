{
  "dry_run": true,
  "fold": {
    "after_days": 1,
    "dry_run": false
  },
  "kind": "retention",
  "lifecycle_status": "active",
  "max_deletes_per_run": null,
  "owns": [
    "state/item-health",
    "state/item-health-summary",
    "frontend/public/telemetry"
  ],
  "series": {
    "aggregate": {
      "unit": "forever"
    },
    "full-grain": {
      "unit": "months",
      "value": 14
    },
    "public-copy": {
      "unit": "months",
      "value": 14
    }
  },
  "window": {
    "unit": "months",
    "value": 14
  }
}
