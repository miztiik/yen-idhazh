{
  "version": "2026-10-10",
  "controls": {
    "memory_profiling_enabled": true,
    "resource_interval_seconds": 30.0,
    "job_sample_interval_seconds": 15.0,
    "memcpy_enabled": false,
    "memcpy_probe_mib": 512,
    "memcpy_passes": 3
  },
  "limits": {
    "max_manifest_bytes": 65536,
    "max_command_bytes": 65536,
    "max_result_bytes": 262144,
    "max_files": 64,
    "max_session_events": 128,
    "max_session_bytes": 8388608,
    "max_read_bytes": 16777216,
    "max_reads": 512,
    "max_workers": 8,
    "max_windows": 16,
    "max_concurrent_windows": 2,
    "retry_window_ms": 5000,
    "poll_ms": 50,
    "readiness_timeout_ms": 10000,
    "ack_timeout_ms": 5000,
    "drain_timeout_ms": 5000
  },
  "capture_limits": {
    "max_proc_text_bytes": 262144,
    "max_sysfs_text_bytes": 65536,
    "max_cpu_id": 4095,
    "max_cpu_ids": 4096,
    "max_cgroup_ancestors": 64,
    "max_mount_entries": 256,
    "max_processes": 256,
    "max_log_bytes": 1048576,
    "max_snapshot_retries": 1
  },
  "verification_limits": {
    "max_files": 64,
    "max_file_bytes": 1048576,
    "max_total_bytes": 16777216,
    "max_rows": 64,
    "max_footer_bytes": 262144,
    "max_decode_bytes": 1048576,
    "max_thrift_items": 4096,
    "max_json_depth": 32
  }
}
