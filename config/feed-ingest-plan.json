{
  "version": "2026-11-05",
  "response": {
    "include_selected_urls": false
  },
  "availability": {
    "consecutive_failed_checks_before_rest": 5,
    "rest_hours": 24,
    "recovery_rest_hours": 24,
    "failed_recovery_checks_before_retirement": 7,
    "retirement_minimum_age_hours": 36
  },
  "harvest": {
    "concurrency": 24,
    "fetch_timeout_ms": 6000,
    "parse_timeout_ms": 10000,
    "request_headers": {
      "primary": {
        "browser": "firefox",
        "headers": {}
      },
      "secondary": {
        "browser": "chrome",
        "headers": {}
      },
      "recoverable_http_statuses": [403, 406, 408, 425, 500, 502, 503, 504],
      "recovery_min_body_bytes": 200
    },
    "response_diagnostics": {
      "header_names": ["content-type", "content-length", "retry-after"],
      "max_header_value_chars": 256
    },
    "request_pacing": {
      "enabled": false,
      "domain_delay_ms": 1000,
      "publisher_delay_ms": 1000,
      "jitter_ms": 500
    },
    "semantic_fallback": {
      "content_roots": [
        "article", "main", "[role='main']", ".post-content", ".article-content",
        ".entry-content", "#content", ".story-body"
      ],
      "remove_elements": [
        "script", "style", "template", "noscript", "iframe", "object", "embed",
        "nav", "header", "footer", "aside", "form", "svg", "button",
        ".ad", ".advertisement", ".social-share", ".cookie-banner", ".comments",
        ".o-em-consent", ".o-em-adblock"
      ],
      "paragraph_elements": ["h1", "h2", "h3", "h4", "h5", "h6", "p", "blockquote", "li"],
      "min_root_chars": 300,
      "min_paragraph_chars": 1,
      "title_sources": [
        { "selector": "meta[property='og:title']", "attribute": "content" },
        { "selector": "meta[name='twitter:title']", "attribute": "content" },
        { "selector": "title", "attribute": null }
      ],
      "author_sources": [
        { "selector": "meta[name='author']", "attribute": "content" },
        { "selector": "meta[property='article:author']", "attribute": "content" },
        { "selector": "[rel='author']", "attribute": null },
        { "selector": "[itemprop='author']", "attribute": null }
      ]
    },
    "blocked_categories": ["links", "show types", "podcasts", "video", "galleries"],
    "url_exclusions": [
      { "host": "fool.com", "path_prefix": "/the-ascent", "include_subdomains": true }
    ]
  },
  "content_filters": {
    "media": {
      "enabled": true,
      "enclosure_type_prefixes": ["audio/", "video/"],
      "url_rules": [
        { "host": "youtube.com", "path_prefix": "/", "include_subdomains": true },
        { "host": "youtu.be", "path_prefix": "/", "include_subdomains": true },
        { "host": "spotify.com", "path_prefix": "/", "include_subdomains": true },
        { "host": "apple.com", "path_prefix": "/podcast", "include_subdomains": true },
        { "host": "apple.com", "path_prefix": "/podcasts", "include_subdomains": true },
        { "host": "podcasts.apple.com", "path_prefix": "/", "include_subdomains": true },
        { "host": "soundcloud.com", "path_prefix": "/", "include_subdomains": true },
        { "host": "aljazeera.com", "path_prefix": "/video", "include_subdomains": true },
        { "host": "vimeo.com", "path_prefix": "/", "include_subdomains": true },
        { "host": "businesstoday.in", "path_prefix": "/bt-tv/market-today/short-video", "include_subdomains": true },
        { "host": "businesstoday.in", "path_prefix": "/bt-tv/whats-hot/short-video", "include_subdomains": true },
        { "host": "businesstoday.in", "path_prefix": "/bt-tv/short-video", "include_subdomains": true }
      ]
    },
    "press_release": {
      "enabled": true,
      "sample_chars": 600,
      "markers": [
        "FOR IMMEDIATE RELEASE", "BUSINESS WIRE", "PR NEWSWIRE",
        "GLOBE NEWSWIRE", "NEWS PROVIDED BY"
      ]
    },
    "link_heavy": {
      "enabled": true,
      "max_link_density": 0.4,
      "max_list_items": 10,
      "list_word_limit": 150
    }
  },
  "triage": {
    "min_words": 180,
    "blocked_http_statuses": [401, 403, 429],
    "recency_half_life_hours": 18,
    "recency_weight": 0.6
  },
  "curate_articles": {
    "article_limit": 100,
    "global_age_ceiling_hours": 36,
    "diversity": {
      "lambda_domain": 0.04,
      "lambda_feed": 0.02,
      "novelty_bonus": 0.15
    },
    "substance": {
      "word_count_ramp_end": 750,
      "word_count_sweet_spot_max": 3500,
      "word_count_plateau_start": 6000,
      "length_scores": { "full": 1.0 },
      "long_form_floor_score": 0.80,
      "entity_density_weight": 0.30,
      "entity_density_full_credit": 1.0,
      "headline_hype_penalty": 0.25,
      "substantive_paragraph_min_words": 25,
      "substantive_paragraph_min_sentences": 2,
      "headline": {
        "shouting_weight": 0.10,
        "punctuation_weight": 0.10,
        "opening_mismatch_weight": 0.05,
        "opening_text_max_characters": 2000,
        "keyword_min_letters": 4,
        "shouting_min_letters": 2,
        "shouting_min_words": 2,
        "shouting_min_uppercase_fraction": 0.50,
        "stop_words": [
          "a", "an", "the", "and", "or", "but", "for", "nor", "so", "yet",
          "as", "at", "by", "in", "of", "on", "to", "with", "from", "into",
          "is", "are", "was", "were", "be", "been", "this", "that", "these", "those"
        ],
        "punctuation_patterns": ["!{2,}", "\\?!", "!\\?"]
      }
    },
    "source_reliability_penalty_enabled": true,
    "source_authority_weight": 1.0,
    "website_grouping": {
      "include_private_suffixes": true
    }
  },
  "discovered_articles": {
    "lookback_days": 90
  },
  "partition": {
    "enabled": true,
    "default_strategy": "bin-pack",
    "default_shards": 4,
    "min_shards": 1,
    "max_shards": 20
  },
  "seal": {
    "compression": "snappy"
  },
  "workflow_reporting": {
    "score_decimal_places": 3,
    "enabled": true,
    "removal_condition": "Delete enabled, this adapter, its tests, and its workflow invocation together when development reporting is no longer needed."
  },
  "feedback": {
    "lifecycle_window_days": 31,
    "request_report_closed_days": 7
  }
}
