{
  "enabled": false,
  "removal_condition": "Remove the enablement flag when the planner is approved for production use.",
  "listener": {
    "hostname": "127.0.0.1",
    "port": 8787,
    "idle_timeout_seconds": 30,
    "max_body_bytes": 16384,
    "max_stage_batches": 128,
    "parser_concurrency": 4
  },
  "inputs": {
    "planning": "config/feed-ingest-plan.json",
    "taxonomy": "config/taxonomy.json",
    "sources": "config/sources.json",
    "extraction": "config/idhazh.json",
    "registrations": "config/ledgers.json",
    "output_root": "state",
    "artifact_root": "backend/var/feed-ingest-plan",
    "health_period_limit": 32,
    "feed_health_input_gap": false,
    "seen_files": [],
    "seen_days": []
  },
  "run": {
    "attempt": 1,
    "producer": "feed-ingest-plan.runner"
  }
}
