# Python / backend
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.svelte-kit/
dev-dist/
*.tsbuildinfo
.vite/
.npm-cache/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor / OS
.DS_Store
Thumbs.db

# New VS Code text uses the repository's LF policy. Every other editor setting
# remains per-developer state and stays out of `git status`.
.vscode/*
!.vscode/settings.json

# Local inference weights. Multi-gigabyte GGUF files - Qwen3-4B-Q4_K_M is
# 2.4 GB and Qwen3-8B-Q4_K_M is 4.8 GB - against a 100 MB per-file ceiling on
# GitHub. CI downloads them from Hugging Face into the Actions cache; a
# developer repopulates them locally. See docs/how-to/set-up-local-inference.md.
backend/models/

# Local llama.cpp binaries (~45 MB). Platform-specific third-party builds that
# are downloaded, not authored, so they are reproducible rather than committed.
# Same repopulation runbook as the weights above.
backend/bin/

# Reproducible run output: per-URL payloads, benchmark JSON, extraction caches.
# Everything here is regenerated by a pipeline run and uploaded as a CI artifact.
# The committed record of a run is the digest under frontend/public/ plus the
# rows under state/ - never the intermediates.
backend/var/

# Scratch
.tmp_*
*.log

# Vite writes this beside vite.config.ts while it loads the config, and leaves
# it behind when the process is killed rather than stopped.
frontend/vite.config.ts.timestamp-*.mjs

# Staged by frontend/scripts/copy-visuals.mjs from the pipeline's own output.
frontend/static/digest/
frontend/static/telemetry/
frontend/static/index/

# Scaffolding for the reference-set authoring pass: a second copy of queue.jsonl,
# split so parallel authors never write one file. Regenerable, never committed.
tests/fixtures/reference/parts/